rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Parent user document: holds the authenticated user's profile + synced
    // preferences. Acts as scope root for the entity subcollections below.
    match /users/{userId} {
      allow read: if request.auth != null
                  && request.auth.uid == userId;

      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && request.resource.data.keys().hasAll(['id', 'version'])
                            && request.resource.data.version is number
                            && request.resource.data.id == userId
                            && request.resource.size() < 10000;

      // Parent user doc is never client-deleted — the user is the scope root.
      allow delete: if false;
    }

    match /users/{userId}/{collection}/{docId} {
      // Only allow known collections
      function isKnownCollection() {
        return collection in [
          'boards', 'tasks', 'taskSteps',
          'boardTasks', 'compositeTasks', 'compositeNodes',
          'compoundChildren'
        ];
      }

      // Top-level entities (Board, Task, CompositeTask) carry a `userId`
      // field in their payload. Child entities (TaskStep, BoardTask,
      // CompositeNode) are scoped via their parent and do not.
      function requiresUserIdField() {
        return collection in ['boards', 'tasks', 'compositeTasks'];
      }

      // Enforces that a user-scoped entity's payload userId matches the
      // path userId. Without this, a buggy or compromised client could
      // write a document under its own path with a spoofed `userId`,
      // which would corrupt the owner's local DB on re-pull and widens
      // the blast radius of any future cross-user share feature.
      function userIdMatchesPath() {
        return !requiresUserIdField()
               || request.resource.data.userId == userId;
      }

      // Reads: auth + collection check only (no request.resource for reads)
      allow read: if request.auth != null
                  && request.auth.uid == userId
                  && isKnownCollection();

      // Writes: auth + collection + field validation + id consistency
      // + (for user-scoped collections) payload.userId === path userId.
      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && isKnownCollection()
                            && request.resource.data.keys().hasAll(['id', 'version'])
                            && request.resource.data.version is number
                            && request.resource.data.id == docId
                            && userIdMatchesPath()
                            && request.resource.size() < 10000;

      // Deletes: auth + collection only (no resource validation needed)
      allow delete: if request.auth != null
                    && request.auth.uid == userId
                    && isKnownCollection();
    }

    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
