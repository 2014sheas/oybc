{
  "name": "oybc-functions",
  "version": "1.0.0",
  "description": "Cloud Functions for OYBC — server-side account-data deletion",
  "private": true,
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc --noEmit && esbuild src/index.ts --bundle --platform=node --target=node22 --format=cjs --outfile=lib/index.js --external:firebase-admin --external:firebase-functions",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions,firestore",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test:run": "vitest run"
  },
  "dependencies": {
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.3.2",
    "resend": "^6.20.0"
  },
  "devDependencies": {
    "@oybc/bingo-core": "file:../packages/bingo-core",
    "esbuild": "^0.28.2",
    "typescript": "^5.5.4",
    "vitest": "^4.1.10"
  }
}
