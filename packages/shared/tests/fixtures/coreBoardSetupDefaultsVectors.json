{
  "_note": "Hand-authored fixture (NOT generated by a script — edit directly). Exercises packages/shared/src/algorithms/coreBoardSetupDefaults.ts's resolveCoreBoardSetupDefaults from both sides: packages/shared/tests/algorithms/coreBoardSetupDefaults.test.ts runs these through the shared TS function; apps/ios/OYBCTests/CoreBoardSetupDefaultsVectorTests.swift runs the SAME vectors through iOS's Swift mirror in Helpers/CoreBoardSetupDefaults.swift. Both must agree for every vector. `coreDefault` is the per-timeframe row's override pair (omitted key = no row / undefined; null = no row; a field that is null or absent = not overridden); `prefs` is the global `UserPreferences` pair. `expected.centerType` is the wizard-ready centre AFTER the even-size rule (an even size never has a centre → `none`), and `expected.hasExplicitSetup` is whether either override field is set (drives the Board-settings summary suffix).",
  "vectors": [
    {
      "name": "no-row-inherits-both",
      "prefs": { "defaultBoardSize": 5, "defaultCenterType": "free" },
      "expected": { "boardSize": 5, "centerType": "free", "hasExplicitSetup": false }
    },
    {
      "name": "null-row-inherits-both",
      "coreDefault": null,
      "prefs": { "defaultBoardSize": 3, "defaultCenterType": "none" },
      "expected": { "boardSize": 3, "centerType": "none", "hasExplicitSetup": false }
    },
    {
      "name": "row-without-overrides-inherits-both",
      "coreDefault": {},
      "prefs": { "defaultBoardSize": 5, "defaultCenterType": "none" },
      "expected": { "boardSize": 5, "centerType": "none", "hasExplicitSetup": false }
    },
    {
      "name": "row-with-null-fields-inherits-both",
      "coreDefault": { "defaultBoardSize": null, "defaultCenterType": null },
      "prefs": { "defaultBoardSize": 3, "defaultCenterType": "free" },
      "expected": { "boardSize": 3, "centerType": "free", "hasExplicitSetup": false }
    },
    {
      "name": "override-size-only-keeps-prefs-centre",
      "coreDefault": { "defaultBoardSize": 3 },
      "prefs": { "defaultBoardSize": 5, "defaultCenterType": "free" },
      "expected": { "boardSize": 3, "centerType": "free", "hasExplicitSetup": true }
    },
    {
      "name": "override-centre-only-keeps-prefs-size",
      "coreDefault": { "defaultCenterType": "none" },
      "prefs": { "defaultBoardSize": 5, "defaultCenterType": "free" },
      "expected": { "boardSize": 5, "centerType": "none", "hasExplicitSetup": true }
    },
    {
      "name": "override-both",
      "coreDefault": { "defaultBoardSize": 3, "defaultCenterType": "none" },
      "prefs": { "defaultBoardSize": 5, "defaultCenterType": "free" },
      "expected": { "boardSize": 3, "centerType": "none", "hasExplicitSetup": true }
    },
    {
      "name": "override-both-free-on-odd-stays-free",
      "coreDefault": { "defaultBoardSize": 5, "defaultCenterType": "free" },
      "prefs": { "defaultBoardSize": 3, "defaultCenterType": "none" },
      "expected": { "boardSize": 5, "centerType": "free", "hasExplicitSetup": true }
    },
    {
      "name": "even-size-override-with-free-override-coerces-to-none",
      "coreDefault": { "defaultBoardSize": 4, "defaultCenterType": "free" },
      "prefs": { "defaultBoardSize": 5, "defaultCenterType": "free" },
      "expected": { "boardSize": 4, "centerType": "none", "hasExplicitSetup": true }
    },
    {
      "name": "even-size-override-with-inherited-free-coerces-to-none",
      "coreDefault": { "defaultBoardSize": 4 },
      "prefs": { "defaultBoardSize": 3, "defaultCenterType": "free" },
      "expected": { "boardSize": 4, "centerType": "none", "hasExplicitSetup": true }
    },
    {
      "name": "even-size-from-prefs-with-free-override-coerces-to-none",
      "coreDefault": { "defaultCenterType": "free" },
      "prefs": { "defaultBoardSize": 4, "defaultCenterType": "none" },
      "expected": { "boardSize": 4, "centerType": "none", "hasExplicitSetup": true }
    },
    {
      "name": "even-size-from-prefs-no-row-coerces-to-none",
      "coreDefault": null,
      "prefs": { "defaultBoardSize": 4, "defaultCenterType": "free" },
      "expected": { "boardSize": 4, "centerType": "none", "hasExplicitSetup": false }
    }
  ]
}
