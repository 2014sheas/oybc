      "name": "normal-in-window-complete",
      "task": { "type": "normal", "maxCount": null },
      "windowStart": "2026-07-01T00:00:00.000Z",
      "events": [
        { "kind": "completion", "delta": null, "occurredAt": "2026-07-05T12:00:00.000Z", "isDeleted": false }
      ],
      "expected": { "isCompleted": true, "count": 1 }
    },
    {
      "name": "normal-pre-window-incomplete",
