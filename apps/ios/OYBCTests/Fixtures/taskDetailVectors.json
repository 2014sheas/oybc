      "expected": { "kind": "toggle", "childId": "a" }
    },
    {
      "name": "only counting children open logs on the first",
      "children": [
        { "id": "a", "type": "normal", "isCompleted": true },
        { "id": "b", "type": "counting", "isCompleted": false },
        { "id": "c", "type": "counting", "isCompleted": false }
      ],
      "expected": { "kind": "log", "childId": "b" }
    },
    {
      "name": "achievement children are never actionable",
