        { "id": "year", "status": "active", "timeframe": "yearly", "endDate": "2026-12-31T23:59:59Z", "updatedAt": "2026-10-01T00:00:00Z" }
      ],
      "expected": "year"
    },
    {
      "name": "open-ended board sorts after a dated one",
      "now": "2026-10-15T12:00:00Z",
      "boards": [
        { "id": "forever", "status": "active", "timeframe": "indefinite", "updatedAt": "2026-10-14T00:00:00Z" },
        { "id": "year", "status": "active", "timeframe": "yearly", "endDate": "2026-12-31T23:59:59Z", "updatedAt": "2026-10-01T00:00:00Z" }
      ],
      "expected": "year"
    },
    {
      "name": "equal deadline and activity tie-breaks on id",
      "now": "2026-10-15T12:00:00Z",
      "boards": [
        { "id": "b", "status": "active", "timeframe": "weekly", "endDate": "2026-10-18T23:59:59Z", "updatedAt": "2026-10-01T00:00:00Z" },
        { "id": "a", "status": "active", "timeframe": "weekly", "endDate": "2026-10-18T23:59:59Z", "updatedAt": "2026-10-01T00:00:00Z" }
      ],
      "expected": "a"
    },
    {
      "name": "nothing in play",
      "now": "2026-10-15T12:00:00Z",
      "boards": [
        { "id": "ended", "status": "active", "timeframe": "weekly", "endDate": "2026-10-11T23:59:59Z", "updatedAt": "2026-10-01T00:00:00Z" }
      ],
      "expected": null
    }
  ],
  "nextSubtask": [
    {
      "name": "first open toggle child",
      "children": [
        { "id": "a", "type": "normal", "isCompleted": true },
        { "id": "b", "type": "counting", "isCompleted": false },
        { "id": "c", "type": "normal", "isCompleted": false }
