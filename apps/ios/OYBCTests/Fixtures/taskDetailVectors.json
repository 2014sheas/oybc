{
  "_note": "Cross-platform vectors for taskDetail.ts <-> TaskDetailKernel.swift (docs/TASK_DETAIL_REDESIGN.md). Hero anchor: soonest-ending in-play board (Boards-tab comparator), id tie-break. Next sub-task: first open Normal/Compound child, else first open Counting child. Activity: derived from events + placements + missed boards + createdAt, newest first. Every instant is UTC so the vectors are timezone-independent.",
  "heroAnchor": [
    {
      "name": "soonest-ending active board wins",
      "now": "2026-10-15T12:00:00Z",
      "boards": [
        { "id": "month", "status": "active", "timeframe": "monthly", "endDate": "2026-10-31T23:59:59Z", "updatedAt": "2026-10-01T00:00:00Z" },
        { "id": "week", "status": "active", "timeframe": "weekly", "endDate": "2026-10-18T23:59:59Z", "updatedAt": "2026-10-01T00:00:00Z" }
      ],
      "expected": "week"
    },
    {
      "name": "sealed, ended, draft and deleted boards are skipped",
      "now": "2026-10-15T12:00:00Z",
      "boards": [
        { "id": "sealed", "status": "active", "timeframe": "weekly", "endDate": "2026-10-16T23:59:59Z", "sealedAt": "2026-10-14T00:00:00Z", "updatedAt": "2026-10-01T00:00:00Z" },
        { "id": "ended", "status": "active", "timeframe": "weekly", "endDate": "2026-10-11T23:59:59Z", "updatedAt": "2026-10-01T00:00:00Z" },
        { "id": "draft", "status": "draft", "timeframe": "weekly", "endDate": "2026-10-16T23:59:59Z", "updatedAt": "2026-10-01T00:00:00Z" },
